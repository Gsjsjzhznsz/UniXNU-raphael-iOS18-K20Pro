+/* Read Android.img from the volume this image was loaded from. The UniXNU menu
+ * starts this loader from the payload FAT, so the file is next to it; when the
+ * firmware's own BDS starts it (no such file) the normal partition path runs. */
+STATIC
+EFI_STATUS
+LinuxLoaderOpenPayloadVolume (EFI_SIMPLE_FILE_SYSTEM_PROTOCOL **FsOut, EFI_FILE_PROTOCOL **RootOut)
+{
+  EFI_STATUS                     Status;
+  EFI_LOADED_IMAGE_PROTOCOL     *Loaded = NULL;
+  EFI_DEVICE_PATH_PROTOCOL      *Remaining = NULL;
+  EFI_HANDLE                     Handle = NULL;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *Fs = NULL;
+  EFI_FILE_PROTOCOL             *Root = NULL;
+
+  *FsOut = NULL; *RootOut = NULL;
+  if (gImageHandle == NULL) return EFI_NOT_FOUND;
+  Status = gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded);
+  if (EFI_ERROR (Status) || (Loaded == NULL)) return Status;
+  Handle = Loaded->DeviceHandle;
+  if (Handle != NULL) {
+    Status = gBS->HandleProtocol (Handle, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+  } else {
+    Status = EFI_NOT_FOUND;
+  }
+  if (EFI_ERROR (Status) && (Loaded->FilePath != NULL)) {
+    Remaining = DuplicateDevicePath (Loaded->FilePath);
+    if (Remaining != NULL) {
+      Handle = NULL;
+      Status = gBS->LocateDevicePath (&gEfiSimpleFileSystemProtocolGuid, &Remaining, &Handle);
+      if (!EFI_ERROR (Status) && (Handle != NULL)) {
+        Status = gBS->HandleProtocol (Handle, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+      }
+      FreePool (Remaining);
+    }
+  }
+  if (EFI_ERROR (Status) || (Fs == NULL)) return EFI_NOT_FOUND;
+  Status = Fs->OpenVolume (Fs, &Root);
+  if (EFI_ERROR (Status)) return Status;
+  *FsOut = Fs; *RootOut = Root;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+LinuxLoaderReadFromVolume (EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *Fs, VOID **Buffer, UINTN *Size)
+{
+  EFI_STATUS          Status;
+  EFI_FILE_PROTOCOL  *Root = NULL;
+  EFI_FILE_PROTOCOL  *File = NULL;
+  EFI_FILE_INFO      *FileInfo = NULL;
+  UINTN               InfoSize = 0;
+  UINTN               ReadSize;
+  STATIC CONST CHAR16 *Candidates[] = { L"\\Android.img", L"Android.img", L"/Android.img" };
+  UINTN               Index;
+  BOOLEAN             Opened = FALSE;
+
+  *Buffer = NULL; *Size = 0;
+  Status = Fs->OpenVolume (Fs, &Root);
+  if (EFI_ERROR (Status)) return Status;
+  for (Index = 0; Index < ARRAY_SIZE (Candidates); Index++) {
+    Status = Root->Open (Root, &File, (CHAR16 *)Candidates[Index], EFI_FILE_MODE_READ, 0);
+    if (!EFI_ERROR (Status)) { Opened = TRUE; break; }
+  }
+  if (!Opened) { Root->Close (Root); return EFI_NOT_FOUND; }
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if (Status != EFI_BUFFER_TOO_SMALL) { File->Close (File); Root->Close (Root); return Status; }
+  FileInfo = AllocatePool (InfoSize);
+  if (FileInfo == NULL) { File->Close (File); Root->Close (Root); return EFI_OUT_OF_RESOURCES; }
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, FileInfo);
+  if (EFI_ERROR (Status) || (FileInfo->FileSize == 0)) {
+    FreePool (FileInfo); File->Close (File); Root->Close (Root);
+    return EFI_ERROR (Status) ? Status : EFI_END_OF_FILE;
+  }
+  *Buffer = AllocatePages (EFI_SIZE_TO_PAGES ((UINTN)FileInfo->FileSize));
+  if (*Buffer == NULL) { FreePool (FileInfo); File->Close (File); Root->Close (Root); return EFI_OUT_OF_RESOURCES; }
+  ReadSize = (UINTN)FileInfo->FileSize;
+  Status = File->Read (File, &ReadSize, *Buffer);
+  FreePool (FileInfo); File->Close (File); Root->Close (Root);
+  if (EFI_ERROR (Status)) { FreePages (*Buffer, EFI_SIZE_TO_PAGES (ReadSize)); *Buffer = NULL; return Status; }
+  *Size = ReadSize;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+LinuxLoaderTryPayloadFile (VOID **Buffer, UINTN *Size)
+{
+  EFI_STATUS                       Status;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *Fs = NULL;
+  EFI_FILE_PROTOCOL               *Root = NULL;
+  EFI_HANDLE                      *Handles = NULL;
+  UINTN                            Count = 0;
+  UINTN                            Index;
+
+  *Buffer = NULL; *Size = 0;
+  Status = LinuxLoaderOpenPayloadVolume (&Fs, &Root);
+  if (!EFI_ERROR (Status) && (Root != NULL)) {
+    Root->Close (Root);
+    Status = LinuxLoaderReadFromVolume (Fs, Buffer, Size);
+    if (!EFI_ERROR (Status)) return Status;
+  }
+  /* The payload image may not carry a volume handle of its own: try every
+   * SimpleFileSystem the firmware publishes. */
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) return Status;
+  for (Index = 0; Index < Count; Index++) {
+    Status = gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+    if (EFI_ERROR (Status)) continue;
+    Status = LinuxLoaderReadFromVolume (Fs, Buffer, Size);
+    if (!EFI_ERROR (Status)) { FreePool (Handles); return EFI_SUCCESS; }
+  }
+  FreePool (Handles);
+  return EFI_NOT_FOUND;
+}
+
+/* The Android boot image read from a file in the payload volume ("file=PATH"). */
+STATIC VOID  *mBootFileBuffer;
+STATIC UINTN mBootFileSize;
+
+
+/* Read "partition=NAME" from the LoadOptions the caller (UniXNU) put on the
+ * image, so the same LinuxLoader can boot an Android image kept in another
+ * partition. NULL keeps the default boot/recovery choice. */
+CHAR8 *
+LinuxLoaderPartitionOverride (VOID)
+{
+  STATIC CHAR8              Name[32];
+  EFI_LOADED_IMAGE_PROTOCOL *Loaded = NULL;
+  CHAR16                    *Args;
+  CHAR16                    *Hit;
+  UINTN                     Index;
+
+  if (gImageHandle == NULL) {
+    return NULL;
+  }
+  if (EFI_ERROR (gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded)) ||
+      (Loaded == NULL) || (Loaded->LoadOptions == NULL)) {
+    return NULL;
+  }
+  Args = (CHAR16 *)Loaded->LoadOptions;
+  Hit = StrStr (Args, L"file=");
+  if (Hit != NULL) {
+    Hit += StrLen (L"file=");
+    Name[0] = 'f'; Name[1] = 'i'; Name[2] = 'l'; Name[3] = 'e'; Name[4] = ':';
+    for (Index = 0; (Index + 6 < sizeof (Name)) && (Hit[Index] != 0) &&
+                    (Hit[Index] != L' ') && (Hit[Index] != L','); Index++) {
+      Name[Index + 5] = (CHAR8)Hit[Index];
+    }
+    Name[Index + 5] = '\0';
+    return (Index == 0) ? NULL : Name;
+  }
+  Hit = StrStr (Args, L"partition=");
+  if (Hit == NULL) {
+    return NULL;
+  }
+  Hit += StrLen (L"partition=");
+  for (Index = 0; (Index + 1 < sizeof (Name)) && (Hit[Index] != 0) && (Hit[Index] != L' ') && (Hit[Index] != L','); Index++) {
+    Name[Index] = (CHAR8)Hit[Index];
+  }
+  Name[Index] = '\0';
+  return (Index == 0) ? NULL : Name;
+}
