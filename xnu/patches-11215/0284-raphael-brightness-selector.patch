+			{ "hardware-max-current-limit", 0 }, { "milliAmps2NitsScaleFactor", 0 },
+				{ "DisplayPanelLuminanceMin", sweetBlMinNits << 16 }, { "DisplayPanelLuminanceMid", sweetBlMidNits << 16 },
+			{ "DisplayPanelLuminanceMax", sweetBlMaxNits << 16 }, { "DisplayProductLuminanceMin", sweetBlMinNits << 16 },
+			{ "DisplayProductLuminanceMid", sweetBlMidNits << 16 }, { "DisplayProductLuminanceMax", sweetBlMaxNits << 16 },
+			{ "MaxNitsPanel", sweetBlMaxNits << 16 }, { "PanelMax", sweetBlMaxNits << 16 },
+		};
+		for (unsigned i = 0; i < sizeof(current) / sizeof(current[0]); i++) {
