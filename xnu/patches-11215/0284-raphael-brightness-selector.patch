+/*
+ * 0285: what CoreBrightness/BrightnessControl read from a backlight service before they will drive it. The set is from
+ * UniXNU's ShengBacklight (package/AppleARMBacklight.cpp, verified on iPadOS 17 and 27):
+ *   IODisplayParameters.brightness {min,max,value}          iOS 17 path: levels 0..2047
+ *   IODisplayParameters.BrightnessMilliNits {min,max,value} BrightnessControl: millinits
+ *   backlight-marketing-table                               signed 16.16 nits at equally spaced slider positions;
+ *                                                           CoreBrightness' Display.m fails (it read it before
+ *                                                           loading it: the backboardd segfault of 0249) without it
+ *   LmaxProduct (4 bytes 16.16), LminProduct, LmidProduct   BrightnessControl's luminance scale; at zero the table
+ *                                                           rescales to infinity and every slider position is max
+ *   backlight-calibration-parameters                        the same six luminances as 16.16 numbers
+ * The panel's luminance was not measured, so 2/140/500 nits set the slider's scale, not an absolute brightness.
+ */
+static const uint32_t sweetBlMinNits = 2, sweetBlMidNits = 140, sweetBlMaxNits = 500;
+
+/*
+ * 0286: CoreBrightness takes the matched service and then dies in CoreFoundation before it sets a property (the 0284
+ * crash: CoreBrightness+0x14659c calls something in CoreFoundation+0x30a8 with a NULL object). Log every property it
+ * reads and every user-client open it tries, so the next boot says which one is missing or unexpected.
+ */
+static void
+sweetBlRead(const char *key)
+{
+	static unsigned reads;
+	if (reads++ < 96) {
+		IOLog("SWEET BL: reads %s\n", key ? key : "(null)");
+	}
+}
+
+OSPtr<OSObject>
+AppleARMBacklight::copyProperty(const OSSymbol *aKey) const
+{
+	sweetBlRead(aKey ? aKey->getCStringNoCopy() : NULL);
+	return IOService::copyProperty(aKey);
+}
+
+OSPtr<OSObject>
+AppleARMBacklight::copyProperty(const char *aKey) const
+{
+	sweetBlRead(aKey);
+	return IOService::copyProperty(aKey);
+}
+
+IOReturn
+AppleARMBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+    IOUserClient **handler)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET BL: %s opens a user client type %u\n", name, type);
+	return IOService::newUserClient(owningTask, securityID, type, properties, handler);
