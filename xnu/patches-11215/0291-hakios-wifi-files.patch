hakios: register the Wi-Fi glue's sources

The 0290 stage script installs bsd/dev/hakios.*.c and bsd/sys/hakios.*.h;
this patch registers the sources with the SWEET kernel build and calls
hakios_wifi_init() where devfs is up, as the iOS 16 tree does.

Nothing runs unless the boot argument wifi=1 (or wifi_step=N) is given:
hakios_wifi_init() parses it and returns at once otherwise, so a normal
boot is unchanged.

diff --git a/bsd/conf/files b/bsd/conf/files
index 9d72300..2ca1a43 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -117,10 +117,18 @@ bsd/dev/sweet_cpufreq.c			standard
 bsd/dev/sweet_charger.c			standard
 bsd/dev/sweet_smmu.c			standard
 bsd/dev/sweet_fb.c			standard
 bsd/dev/sweet_scanout.c		standard
 bsd/dev/raphael_dsi.c			standard
+bsd/dev/hakios.wifi.c		standard
+bsd/dev/hakios.wlfw.c		standard
+bsd/dev/hakios.qmi.c		standard
+bsd/dev/hakios.lx.c		standard
+bsd/dev/hakios.net.c		standard
+bsd/dev/hakios.sta.c		standard
+bsd/dev/hakios.apple80211.c		standard
+bsd/dev/hakios.wifi_shim.c		standard
 bsd/dev/sweet_a630.c			standard
 bsd/dev/sweet_a630_pas.c			standard
 bsd/dev/beryllium_wlan.c		standard
 bsd/dev/beryllium_bt_hci.c		standard
 bsd/dev/mem.c				standard
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 6943eac..0586533 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -144,10 +144,11 @@
 #include <sys/protosw.h>                /* for domaininit() */
 #include <kern/sched_prim.h>            /* for thread_wakeup() */
 #include <net/if_ether.h>               /* for ether_family_init() */
 #include <net/if_gif.h>                 /* for gif_init() */
 #include <miscfs/devfs/devfsdefs.h>     /* for devfs_kernel_mount() */
+#include <sys/hakios.input.h>           /* for hakios_wifi_init() */
 #include <vm/vm_kern.h>                 /* for kmem_suballoc() */
 #include <sys/proc_uuid_policy.h>       /* proc_uuid_policy_init() */
 #include <netinet/flow_divert.h>        /* flow_divert_init() */
 #include <net/content_filter.h>         /* for cfil_init() */
 #include <net/necp.h>                   /* for necp_init() */
@@ -1047,10 +1048,11 @@ bsd_init(void)
 	{
 		char mounthere[] = "/dev"; /* !const because of internal casting */
 
 		bsd_init_kprintf("calling devfs_kernel_mount\n");
 		devfs_kernel_mount(mounthere);
+		hakios_wifi_init();             /* boot-arg wifi=1: the phone's Wi-Fi (bsd/dev/hakios.wifi.c) */
 	}
 #endif /* DEVFS */
 
 #if CONFIG_BASESYSTEMROOT
 #if CONFIG_IMAGEBOOT
